{
  "homepage": "https://www.interactivelearner-gis.com",
  "name": "interactivelearner-gis",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/build-ai.mjs",
    "preview": "vitepress preview docs",
    "mcp:dev": "wrangler dev --config mcp/wrangler.jsonc",
    "mcp:deploy": "wrangler deploy --config mcp/wrangler.jsonc",
    "cf-typegen": "wrangler types --config mcp/wrangler.jsonc worker-configuration.d.ts",
    "ai:generate": "node scripts/ai-content.mjs",
    "predev": "pnpm ai:generate",
    "prebuild": "pnpm ai:generate",
    "premcp:dev": "pnpm ai:generate",
    "premcp:deploy": "pnpm ai:generate",
    "test": "pnpm ai:generate && node --test tests/*.test.mjs",
    "typecheck": "pnpm ai:generate && tsc -p mcp/tsconfig.json && vue-tsc -p tsconfig.ai.json --noEmit",
    "preview:cloudflare": "wrangler pages dev --port 8792 --persist-to .wrangler/pages-preview"
  },
  "dependencies": {
    "@arcgis/core": "5.2.7",
    "@arcgis/map-components": "5.2.7",
    "@esri/calcite-components": "^5.2.1",
    "@floating-ui/vue": "^2.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@w3c/webmcp-polyfill": "0.1.1",
    "agents": "^0.34.0",
    "d3": "^7.9.2",
    "leaflet": "^1.9.4",
    "simple-statistics": "^8.0.0",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.3.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-sidebar": "^1.41.0",
    "vue-tsc": "^3.3.14",
    "webmcp-types": "0.1.11",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "vitepress-sidebar>glob": "^14.0.2"
    }
  },
  "engines": {
    "node": "^24.22.3"
  }
}
