{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gis-docs-mcp",
  "main": "index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "MyMCP"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
